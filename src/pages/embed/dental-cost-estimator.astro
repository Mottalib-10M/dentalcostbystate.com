---
/** Embeddable page (iframe): the estimator alone. noindex, outside the sitemap (astro.config). */
import '../../styles/global.css';
import Tool from '../../components/Tool.astro';
import { SITE_URL, SITE_NAMES } from '../../data/site-config';
---
<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dental cost estimator by state (widget)</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={`${SITE_URL}/en/`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
  </head>
  <body class="bg-white p-2 text-navy-900">
    <main><Tool kind="cost" idPrefix="embed" /></main>
    <p class="mt-2 text-center text-xs text-navy-600"><a href={`${SITE_URL}/en/`} target="_blank" rel="noopener" class="underline">{SITE_NAMES.en}</a> · state Medicaid fee schedules and ADA ratios · an estimate, not a quote and not dental advice</p>
  </body>
</html>
