---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/dental-cost-estimator/" title="Dental cost estimator by state" width="100%" height="820" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the dental cost estimator by state, free of charge" description="Community health sites, newsrooms and benefits pages can embed the dental cost estimator by state with one iframe line. No cookie, no tracking, no lead form, no appointment button." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Embed the estimator', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Embed the estimator' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="font-serif text-3xl font-bold text-navy-900 md:text-4xl">Embed the dental cost estimator</h1>
    <p class="mt-3 text-lg text-navy-700">One line of code. When a state publishes a new fee schedule and we load it, the embedded estimator follows.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <p>Terms: keep the credit line under the estimator visible, do not alter the frame, and do not place it next to a booking form, a credit offer or a plan sale. The frame sets no cookie and sends us nothing about your readers. Questions: <a href={route('contact', lang)}>contact page</a>.</p>
    <h2>Dental cost by procedure, state and plan</h2>
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src="/embed/dental-cost-estimator/" title="Dental cost estimator by state" width="100%" height="820" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
